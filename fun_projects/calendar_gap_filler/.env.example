# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Ticketmaster Discovery API key (see README.md for how to get one).
TICKETMASTER_API_KEY=

# Your approximate home location, used to search for nearby events.
# This is personal data — keep it in .env, never commit real values.
USER_LATITUDE=
USER_LONGITUDE=
USER_SEARCH_RADIUS_KM=20
